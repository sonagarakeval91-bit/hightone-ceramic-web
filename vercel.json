{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/og-image/:collection",
      "destination": "/api/og-image?collection=:collection"
    },
    {
      "source": "/share/:collection",
      "destination": "/api/share?collection=:collection"
    },
    {
      "source": "/collections",
      "destination": "/api/seo-page?route=collections"
    },
    {
      "source": "/collections/",
      "destination": "/api/seo-page?route=collections"
    },
    {
      "source": "/collections/:collection",
      "destination": "/api/seo-page?route=collections&collection=:collection"
    },
    {
      "source": "/collections/:collection/",
      "destination": "/api/seo-page?route=collections&collection=:collection"
    },
    {
      "source": "/collection",
      "destination": "/api/seo-page?route=collections"
    },
    {
      "source": "/collection/:collection",
      "destination": "/api/seo-page?route=collections&collection=:collection"
    },
    {
      "source": "/b2b",
      "destination": "/api/seo-page?route=b2b"
    },
    {
      "source": "/b2b/",
      "destination": "/api/seo-page?route=b2b"
    },
    {
      "source": "/about",
      "destination": "/api/seo-page?route=about"
    },
    {
      "source": "/about/",
      "destination": "/api/seo-page?route=about"
    },
    {
      "source": "/blog",
      "destination": "/api/seo-page?route=blog"
    },
    {
      "source": "/blog/",
      "destination": "/api/seo-page?route=blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/seo-page?route=blog&slug=:slug"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/api/seo-page?route=blog&slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/og-image/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
