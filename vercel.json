{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/share/:collection",
      "destination": "/api/share?collection=:collection"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
